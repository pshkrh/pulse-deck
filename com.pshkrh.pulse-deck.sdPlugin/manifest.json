{
  "Name": "Pulse Deck: System Info",
  "Version": "1.0.0",
  "Author": "pshkrh",
  "Description": "Live CPU, memory, ping latency, battery, and uptime telemetry with polished animated key graphs for macOS.",
  "UUID": "com.pshkrh.pulse-deck",
  "Icon": "imgs/pluginIcon",
  "Category": "System Info",
  "CategoryIcon": "imgs/pluginIcon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "11"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "Name": "CPU",
      "UUID": "com.pshkrh.pulse-deck.cpu",
      "Icon": "imgs/actionCpu",
      "Tooltip": "Live CPU percentage and graph",
      "States": [
        {
          "Image": "imgs/actionCpu"
        }
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Memory",
      "UUID": "com.pshkrh.pulse-deck.memory",
      "Icon": "imgs/actionMemory",
      "Tooltip": "Live memory percentage and graph",
      "States": [
        {
          "Image": "imgs/actionMemory"
        }
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Ping",
      "UUID": "com.pshkrh.pulse-deck.ping",
      "Icon": "imgs/actionPing",
      "Tooltip": "Internet latency trend (1.1.1.1, fallback 8.8.8.8)",
      "PropertyInspectorPath": "property-inspector/ping.html",
      "States": [
        {
          "Image": "imgs/actionPing"
        }
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Battery",
      "UUID": "com.pshkrh.pulse-deck.battery",
      "Icon": "imgs/actionBattery",
      "Tooltip": "Battery percentage and trend",
      "States": [
        {
          "Image": "imgs/actionBattery"
        }
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Uptime",
      "UUID": "com.pshkrh.pulse-deck.uptime",
      "Icon": "imgs/actionUptime",
      "Tooltip": "System uptime since last reboot",
      "States": [
        {
          "Image": "imgs/actionUptime"
        }
      ],
      "SupportedInMultiActions": false
    }
  ]
}
